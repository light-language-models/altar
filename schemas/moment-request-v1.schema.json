{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://altar.example/schema/moment-request-v1.json",
  "title": "Altar Moment Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["at_utc", "mode", "pack_id", "observer"],
  "properties": {
    "at_utc": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["silence", "note", "chord", "field"]},
    "pack_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "observer": {"type": "string", "minLength": 1, "maxLength": 80},
    "event_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 200}
  }
}
